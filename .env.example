# Supabase (end-word project)
NEXT_PUBLIC_SUPABASE_URL=https://wvvpheefkzildcguzzfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Korean dictionary API (local: uvicorn on :8000; Vercel: Python function at /api/dictionary)
# Local:  DICTIONARY_URL=http://localhost:8000
# Vercel: DICTIONARY_URL=https://your-deployment.vercel.app/api/dictionary
#         (optional on Vercel — defaults to https://$VERCEL_URL/api/dictionary)
DICTIONARY_URL=http://localhost:8000

# Temporary site-wide lock (unset or leave empty to disable)
# SITE_PASSWORD=your-shared-password

# Dictionary mocks for tests
MOCK_GET_RANDOM_WORD=false
MOCK_LOOKUP_WORD=false
MOCK_WORD_VALIDATION_FAIL=false
