{
	"python.defaultInterpreterPath": "${workspaceFolder}/dictionary/.venv/Scripts/python.exe",
	"python.venvPath": "${workspaceFolder}/dictionary",
	"python.terminal.activateEnvironment": true,
	"python.analysis.stubPath": "dictionary/stubs",
	"python.analysis.extraPaths": ["dictionary/stubs"],
	"python.analysis.diagnosticMode": "workspace",
	"python.testing.pytestEnabled": true,
	"python.testing.cwd": "${workspaceFolder}/dictionary",
	"python.testing.pytestArgs": ["tests"],
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"eslint.rules.customizations": [
		{
			"rule": "no-explicit-any",
			"severity": "off"
		}
	],
	"cursorpyright.analysis.stubPath": "dictionary/stubs",
	"cursorpyright.analysis.extraPaths": ["dictionary/stubs"],
	"cursorpyright.analysis.diagnosticMode": "workspace",
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.ruff": "explicit",
			"source.organizeImports.ruff": "explicit"
		}
	}
}
